<div class="flex align-middle gap-x-4 ml-auto" id="js-other-actions-wrapper">
  <%= link_to t("actions.transfer", scope: "decidim.plans"), Decidim::EngineRouter.admin_proxy(current_component).new_transfer_path, class: "button button__sm button__secondary" %>

  <%= link_to t("actions.sections", scope: "decidim.plans"), Decidim::EngineRouter.admin_proxy(current_component).sections_path, class: "button button__sm button__secondary" %>

  <% if allowed_to? :create, :plan %>
    <%= link_to t("actions.new", scope: "decidim.plans"), Decidim::EngineRouter.admin_proxy(current_component).new_plan_path, class: "button button__sm button__secondary" %>
  <% end %>

  <% if allowed_to? :export_budgets, :plans %>
    <%= link_to t("actions.export_budgets", scope: "decidim.plans"), Decidim::EngineRouter.admin_proxy(current_component).new_budgets_export_path, class: "button button__sm button__secondary" %>
  <% end %>

  <% if allowed_to? :export, :plans %>
    <%= export_dropdowns(query) %>
  <% end %>
</div>
